<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: plik konta (token i DEK zaszyfrowane kluczem Keystore tego telefonu) nie trafia do kopii ani na nowy telefon -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="account.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="account.xml" />
    </device-transfer>
</data-extraction-rules>
