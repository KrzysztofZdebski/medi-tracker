# Copy to .env (deploy.sh does this automatically on first deploy).
# Hex, at least 32 chars: openssl rand -hex 32
SERVER_SECRET=change-me
# log = dev only: prints codes and recipients to the container log. smtp = real mail.
EMAIL_MODE=log
# Only for EMAIL_MODE=smtp (Gmail: app password, not the account password):
#SMTP_HOST=smtp.gmail.com
#SMTP_USER=you@gmail.com
#SMTP_PASS=app-password
#SMTP_FROM=mediTracker <you@gmail.com>
# Optional: BACKUP_DIR (default /data/backups), RUST_LOG (default info)
